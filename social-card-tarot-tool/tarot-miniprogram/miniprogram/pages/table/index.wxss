.page{height:100vh;position:relative;overflow:hidden;background:#060c11}.room{position:absolute;top:2%;left:-5.555%;width:111.11%}.shade{position:absolute;inset:0;background:linear-gradient(0deg,#060c11 0%,transparent 28%,transparent 88%,#060c1155)}.brand{position:relative;margin:28rpx 34rpx;display:flex;gap:14rpx;align-items:center;letter-spacing:3rpx;font:22rpx Georgia,serif;color:#dfc58f}.moon{font-size:45rpx}.help{margin-left:auto;font-size:28rpx;min-height:60rpx;width:60rpx;padding:0;border:1rpx solid #b3985944;border-radius:50%;line-height:58rpx}.fan{position:absolute;top:27%;left:0;right:0;height:220rpx}.fan-card{position:absolute;width:66.37rpx;height:112rpx;border-radius:2rpx;transform-origin:50% 100%;opacity:0;filter:drop-shadow(0 2rpx 3rpx #000)}.spread-ready .fan-card{animation:spread-in 1.1s both ease-out}.fan-card.chosen{visibility:hidden}@keyframes spread-in{from{opacity:0;margin-top:60rpx}to{opacity:1;margin-top:0}}.table-controls{position:absolute;bottom:16rpx;left:28rpx;right:28rpx;text-align:center}.question-wrap{position:relative;padding:30rpx 16rpx 36rpx 46rpx;background:radial-gradient(ellipse,#080a0bcc,transparent 72%)}.question-quill{position:absolute;left:0;top:40rpx;width:40rpx;height:75rpx;opacity:.6}.question{width:100%;height:115rpx;font-size:35rpx;line-height:1.7;color:#f2dfb8;text-align:center;background:transparent}.question-placeholder{color:#d6c39f}.ink-line{position:absolute;left:0;right:0;bottom:15rpx;height:15rpx;border-bottom:1rpx solid #c9a84c66;border-radius:50%;color:#c9a84c;font-size:20rpx}.ink-line text{position:relative;top:-4rpx;padding:0 15rpx;background:#080d10}.actions{display:flex;justify-content:center;gap:24rpx}.actions button{font-size:27rpx;color:#e2c78d;padding:12rpx;min-height:80rpx}.actions .shuffle{color:#b3a68e;font-size:24rpx}.notice{font-size:18rpx;color:#8b826d}.selected{position:absolute;bottom:305rpx;left:34rpx;right:34rpx;display:flex;justify-content:center;gap:18rpx}.selected-card{width:31%;text-align:center;font-size:22rpx;color:#d8c39d}.card-face{width:100%;height:280rpx;display:block}.orientation{display:block;color:#a99f8b;font-size:18rpx}.picker-mask{position:fixed;inset:0;background:#04080b66;z-index:8}.picker{position:fixed;left:0;right:0;bottom:0;z-index:9;background:linear-gradient(#11120ff5,#080d10);padding:30rpx 0 max(28rpx,env(safe-area-inset-bottom));color:#e5d2a5}.picker-heading{display:flex;align-items:center;justify-content:space-between;padding:0 44rpx;font-size:40rpx;letter-spacing:3rpx}.picker-heading button{font-size:50rpx;min-height:76rpx;padding:0;width:76rpx}.picker-hint{display:block;margin:0 44rpx;font-size:23rpx;color:#bcad90}.deck{height:540rpx;margin-top:14rpx}.deck-row{display:flex;align-items:flex-start;box-sizing:border-box;padding:35rpx 32.5vw 70rpx;height:100%;gap:14px}.picker-card{flex:0 0 35vw;width:35vw;height:59.0625vw;transform-origin:50% 100%;border:1rpx solid #b4a071;border-radius:4rpx;box-shadow:0 12rpx 30rpx #0009}.picker-card image{width:100%;height:100%}.picker-card.chosen{opacity:.18}.picker-selected{display:flex;justify-content:center;gap:42rpx}.picker-slot{width:76rpx;height:130rpx;color:#9a875858;text-align:center;font-size:52rpx}.picker-slot image{width:100%;height:100%}.loader{position:fixed;inset:0;z-index:20;background:radial-gradient(ellipse at 50% 46%,#22212d,#080b11 76%);display:flex;align-items:center;justify-content:center;flex-direction:column;color:#e8d3a9;font-size:26rpx;letter-spacing:3rpx}.witch{position:relative;width:400rpx;height:400rpx;margin-bottom:20rpx}.witch image{position:absolute;width:100%;height:100%}.witch-wand{transform-origin:57.08% 52.5%;animation:wand-cast 2.8s infinite ease-in-out}@keyframes wand-cast{0%,100%{transform:rotate(-12deg)}35%{transform:rotate(16deg)}60%,80%{transform:rotate(-23deg)}}
@media(max-height:600px){.deck{height:420rpx}.selected{bottom:280rpx}.card-face{height:210rpx}}

.table-controls,.picker-heading,.picker-hint{font-family:TarotInk,"Songti SC",serif;font-weight:300}.question,.question-placeholder{font-family:TarotInk,"Songti SC",serif;font-weight:300}.brand .help{flex:0 0 60rpx;max-width:60rpx;margin:0 0 0 auto}.actions button{flex:none;width:auto}

.credits-chip{margin-left:auto;margin-right:12rpx;padding:6rpx 16rpx;border:1rpx solid #b3985944;border-radius:999rpx;font-size:20rpx;color:#dfc58f;letter-spacing:1rpx}
.brand .help{margin-left:0}
.spread-row{position:relative;z-index:2;display:flex;align-items:center;gap:12rpx;padding:0 34rpx;margin-top:8rpx}
.spread-label{font-size:22rpx;color:#b3a68e;margin-right:4rpx}
.spread-chip{padding:8rpx 22rpx;border:1rpx solid #b3985944;border-radius:999rpx;font-size:24rpx;color:#c9b48a;background:#0c1216aa}
.spread-chip.active{color:#101719;background:#dfc58f;border-color:#dfc58f}
.disclaimer{display:block;margin-top:10rpx;line-height:1.55;padding:0 8rpx}
.legal-links{margin-top:8rpx;font-size:20rpx;color:#8b826d}
.legal-links text{padding:4rpx 8rpx}
.legal-sep{opacity:.5}
