# Sub2API / OpenAI-compatible config
SUB2API_API_KEY=YOUR_SUB2API_API_KEY_HERE
SUB2API_BASE_URL=https://api.yksa.uk/v1
SUB2API_MODEL=gpt-5.6-sol
SUB2API_FALLBACK_MODELS=gpt-5.5,gpt5

# Local or Render backend
HOST=0.0.0.0
PORT=8790

# Public demo protection
ACCESS_CODE=CHANGE_ME_TO_A_PRIVATE_DEMO_CODE
RATE_LIMIT_MAX_PER_DAY=3

# For Render production set this after Vercel URL is known
# Example: https://your-vercel-project.vercel.app
ALLOWED_ORIGINS=*

# --- Pay ledger ---
# Local mock (no real money): PAY_DEV_MODE=1 and omit WECHAT_* pay secrets.
PAY_DEV_MODE=1
# Optional JSON path override (default: server/data/ledger.json) when DATABASE_URL unset
# PAY_LEDGER_PATH=
# Production durable ledger: Render Postgres addon → Internal Database URL
# DATABASE_URL=postgres://...
# PGSSLMODE=disable

# --- WeChat mini-program login ---
# Required for real login; skip when PAY_DEV_MODE=1.
# WECHAT_APPID=
# WECHAT_SECRET=

# --- WeChat Pay JSAPI (env-gated; mock if incomplete + PAY_DEV_MODE=1) ---
# WECHAT_MCH_ID=
# WECHAT_API_V3_KEY=
# WECHAT_MCH_SERIAL_NO=
# WECHAT_MCH_PRIVATE_KEY=
# WECHAT_MCH_PRIVATE_KEY_PATH=
# WECHAT_NOTIFY_URL=https://api.witchtable.cn/v1/pay/notify
# Optional platform cert for notify verify (else fetched via /v3/certificates)
# WECHAT_PLATFORM_CERT=
# WECHAT_PLATFORM_PUBLIC_KEY=

# When 1: /v1/messages requires a session token (breaks anonymous H5). Default off.
# Authenticated follow-up (header X-Reading-Follow-Up: 1 or body.metadata.followUp)
# skips credit deduct; abuse bounded by RATE_LIMIT_MAX_PER_DAY.
# REQUIRE_CREDITS_FOR_MESSAGES=0

# Keep-alive script (scripts/keepalive.mjs)
# HEALTH_URL=https://intuitive-tarot-production.onrender.com/health
